# =============================================================================
# .env.example - TEMPLATE. Salin jadi .env lalu isi nilainya.
#   cp .env.example .env        (Windows: Copy-Item .env.example .env)
# JANGAN commit .env yang sudah terisi.
# =============================================================================

# --- Web: eSuite ---
ESUITE_BASE_URL=https://esuite.edot.id
ESUITE_EMAIL=
ESUITE_PASSWORD=

# --- Mobile: eWork SFA ---
# Utamakan company hasil TC-WEB-005 (trial 30 hari = aktif).
# Bila memakai fallback, catat di README.
EWORK_COMPANY_ID=
EWORK_USERNAME=
EWORK_PASSWORD=
EWORK_APP_ID=

# --- AI (Phase 3A) ---
# Kosongkan untuk memaksa jalur fallback Faker. Suite tetap harus jalan.
AI_API_KEY=
AI_MODEL=

# --- Runtime ---
HEADLESS=true
DEFAULT_TIMEOUT_MS=30000
